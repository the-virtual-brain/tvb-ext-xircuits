                    "extras": {
                        "type": "debug",
                        "path": "xai_components/xai_tvb_coupling/coupling.py",
                        "description": "<div class=\"document\" id=\"traited-class-tvb-simulator-coupling-difference\">\n<h1 class=\"title\">Traited class [tvb.simulator.coupling.Difference]</h1>\n<blockquote>\n<p>Provides a difference coupling function, between pre and post synaptic\nactivity of the form</p>\n<div class=\"math\">\n\\begin{equation*}\na G_ij (x_j - x_i)\n\\end{equation*}\n</div>\n</blockquote>\n<div class=\"section\" id=\"attributes-declared\">\n<h1>Attributes declared</h1>\n<dl class=\"docutils\">\n<dt>a <span class=\"classifier-delimiter\">:</span> <span class=\"classifier\">tvb.simulator.coupling.Difference.a = NArray(label='<span class=\"math\">\\(a\\)</span>', dtype=float64, default=array([0.1]), dim_names=(), ndim=None, required=True)</span></dt>\n<dd>Rescales the connection strength.</dd>\n</dl>\n<p>gid : tvb.basic.neotraits._core.HasTraits.gid = Attr(field_type=&lt;class 'uuid.UUID'&gt;, default=None, required=True)</p>\n</div>\n</div>\n",
                        "argumentDescriptions": {
                            "a": "<div class=\"document\">\n<p>Rescales the connection strength.</p>\n</div>\n"
                        },
